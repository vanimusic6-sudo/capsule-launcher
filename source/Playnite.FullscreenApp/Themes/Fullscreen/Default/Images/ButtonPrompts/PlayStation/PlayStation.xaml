<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CapsulePsRoundPrompt" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="CapsulePsWidePrompt" TargetType="Border">
        <Setter Property="MinWidth" Value="42" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="5,0" />
    </Style>

    <Style x:Key="CapsulePsPromptText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="ButtonPromptA"><Viewbox><Border Style="{StaticResource CapsulePsRoundPrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" Text="✕"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptB"><Viewbox><Border Style="{StaticResource CapsulePsRoundPrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" Text="○"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptX"><Viewbox><Border Style="{StaticResource CapsulePsRoundPrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" Text="□"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptY"><Viewbox><Border Style="{StaticResource CapsulePsRoundPrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" Text="△"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptLB"><Viewbox><Border Style="{StaticResource CapsulePsWidePrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" Text="L1"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptRB"><Viewbox><Border Style="{StaticResource CapsulePsWidePrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" Text="R1"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptLT"><Viewbox><Border Style="{StaticResource CapsulePsWidePrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" Text="L2"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptRT"><Viewbox><Border Style="{StaticResource CapsulePsWidePrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" Text="R2"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptBack"><Viewbox><Border Style="{StaticResource CapsulePsWidePrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" FontSize="11" Text="Create"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptStart"><Viewbox><Border Style="{StaticResource CapsulePsWidePrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" FontSize="11" Text="Options"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptLS"><Viewbox><Border Style="{StaticResource CapsulePsRoundPrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" FontSize="12" Text="L3"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptRS"><Viewbox><Border Style="{StaticResource CapsulePsRoundPrompt}"><TextBlock Style="{StaticResource CapsulePsPromptText}" FontSize="12" Text="R3"/></Border></Viewbox></DataTemplate>
</ResourceDictionary>
