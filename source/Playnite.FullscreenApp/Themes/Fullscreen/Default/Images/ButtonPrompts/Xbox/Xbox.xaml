<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CapsuleRoundPrompt" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="CapsuleWidePrompt" TargetType="Border">
        <Setter Property="MinWidth" Value="42" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="5,0" />
    </Style>

    <Style x:Key="CapsulePromptText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="ButtonPromptA"><Viewbox><Border Style="{StaticResource CapsuleRoundPrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="A"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptB"><Viewbox><Border Style="{StaticResource CapsuleRoundPrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="B"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptX"><Viewbox><Border Style="{StaticResource CapsuleRoundPrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="X"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptY"><Viewbox><Border Style="{StaticResource CapsuleRoundPrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="Y"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptLB"><Viewbox><Border Style="{StaticResource CapsuleWidePrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="LB"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptRB"><Viewbox><Border Style="{StaticResource CapsuleWidePrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="RB"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptLT"><Viewbox><Border Style="{StaticResource CapsuleWidePrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="LT"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptRT"><Viewbox><Border Style="{StaticResource CapsuleWidePrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="RT"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptBack"><Viewbox><Border Style="{StaticResource CapsuleWidePrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="View"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptStart"><Viewbox><Border Style="{StaticResource CapsuleWidePrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" Text="Menu"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptLS"><Viewbox><Border Style="{StaticResource CapsuleRoundPrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" FontSize="12" Text="LS"/></Border></Viewbox></DataTemplate>
    <DataTemplate x:Key="ButtonPromptRS"><Viewbox><Border Style="{StaticResource CapsuleRoundPrompt}"><TextBlock Style="{StaticResource CapsulePromptText}" FontSize="12" Text="RS"/></Border></Viewbox></DataTemplate>
</ResourceDictionary>
