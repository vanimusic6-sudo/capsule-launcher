<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="ListGameItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="CapsuleSelectOn">
                            <DoubleAnimation Storyboard.TargetName="CardShell"
                                             Storyboard.TargetProperty="Height"
                                             From="150" To="315"
                                             Duration="0:0:0.30">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MainOutline"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1"
                                             Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="OutlineSweep"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.95" To="0"
                                             BeginTime="0:0:0.08"
                                             Duration="0:0:0.42" />
                            <DoubleAnimation Storyboard.TargetName="OutlineSweep"
                                             Storyboard.TargetProperty="StrokeDashOffset"
                                             From="26" To="-4"
                                             Duration="0:0:0.48">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>

                        <Storyboard x:Key="CapsuleSelectOff">
                            <DoubleAnimation Storyboard.TargetName="CardShell"
                                             Storyboard.TargetProperty="Height"
                                             To="150"
                                             Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MainOutline"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="OutlineSweep"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.08" />
                        </Storyboard>
                    </ControlTemplate.Resources>

                    <Grid Margin="9,0,9,0"
                          VerticalAlignment="Top"
                          ClipToBounds="False"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <Border x:Name="CardShell"
                                Height="150"
                                VerticalAlignment="Top"
                                Background="#1A1A1A"
                                CornerRadius="11"
                                ClipToBounds="True"
                                RenderTransformOrigin="0.5,0">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>

                        <Rectangle x:Name="MainOutline"
                                   Height="{Binding ActualHeight, ElementName=CardShell}"
                                   VerticalAlignment="Top"
                                   RadiusX="11"
                                   RadiusY="11"
                                   Stroke="White"
                                   StrokeThickness="3"
                                   Opacity="0"
                                   IsHitTestVisible="False" />

                        <Rectangle x:Name="OutlineSweep"
                                   Height="{Binding ActualHeight, ElementName=CardShell}"
                                   VerticalAlignment="Top"
                                   RadiusX="11"
                                   RadiusY="11"
                                   Stroke="#FFFFFFFF"
                                   StrokeThickness="3.5"
                                   StrokeDashArray="1 19"
                                   StrokeDashOffset="26"
                                   Opacity="0"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Binding="{Binding DataContext.CapsuleLaunchTransitionActive,
                                            RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}}"
                                           Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Panel.ZIndex" Value="90" />
                            <Setter TargetName="CardShell" Property="Height" Value="315" />
                            <Setter TargetName="MainOutline" Property="Opacity" Value="1" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource CapsuleSelectOn}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource CapsuleSelectOff}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Panel.ZIndex" Value="100" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>