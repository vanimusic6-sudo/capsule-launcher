<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="CapsuleHeroPrimaryButton" TargetType="ButtonEx">
        <Setter Property="Height" Value="86" />
        <Setter Property="MinWidth" Value="555" />
        <Setter Property="Background" Value="#F5F5F5" />
        <Setter Property="Foreground" Value="#151515" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="FontSize" Value="31" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWeb}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="13"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFFFF" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.025" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.025" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CapsuleHeroMoreButton" TargetType="ButtonEx">
        <Setter Property="Height" Value="86" />
        <Setter Property="Width" Value="108" />
        <Setter Property="Background" Value="#591B1B1B" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#80FFFFFF" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontSize" Value="39" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#8C222222" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          Background="#0D1012"
                          d:DesignWidth="1920"
                          d:DesignHeight="1080"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">

                        <Grid x:Name="PART_ViewHost"
                              Background="#0D1012"
                              ClipToBounds="True">

                            <!-- Full-bleed selected-game artwork. -->
                            <FadeImage x:Name="PART_ImageBackground"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />

                            <!-- Functional readability masks only; no decorative glow layers. -->
                            <Rectangle Fill="#23000000" IsHitTestVisible="False" />
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#D9000000" Offset="0" />
                                        <GradientStop Color="#A8000000" Offset="0.28" />
                                        <GradientStop Color="#28000000" Offset="0.58" />
                                        <GradientStop Color="#00000000" Offset="0.79" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                        <GradientStop Color="#B8000000" Offset="0" />
                                        <GradientStop Color="#58000000" Offset="0.28" />
                                        <GradientStop Color="#00000000" Offset="0.58" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Design surface keeps the console geometry consistent at 16:9 resolutions. -->
                            <Viewbox Stretch="Fill">
                                <Grid Width="1920" Height="1080">

                                    <!-- Top-right system area. -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,34,68,0">
                                        <TextBlock x:Name="PART_TextClock"
                                                   Margin="0,0,28,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"
                                                   FontFamily="{DynamicResource FontTitilliumWeb}"
                                                   FontSize="29" />
                                        <ButtonEx x:Name="PART_ButtonMainMenu"
                                                  Width="54" Height="54"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  FocusVisualStyle="{x:Null}">
                                            <ButtonEx.Template>
                                                <ControlTemplate TargetType="ButtonEx">
                                                    <Grid>
                                                        <TextBlock Text="⚙"
                                                                   FontFamily="Segoe UI Symbol"
                                                                   FontSize="34"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Border x:Name="FocusRing"
                                                                BorderBrush="White"
                                                                BorderThickness="2"
                                                                CornerRadius="27"
                                                                Opacity="0" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.72" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ButtonEx.Template>
                                        </ButtonEx>
                                    </StackPanel>

                                    <!-- Capsule shelf. The selected card grows downward from this row. -->
                                    <ListBoxEx x:Name="PART_ListGameItems"
                                               Width="1710"
                                               Height="370"
                                               Margin="105,80,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               ClipToBounds="False"
                                               ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                               ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                               KeyboardNavigation.DirectionalNavigation="Once"
                                               Panel.ZIndex="20" />

                                    <!-- Selected-game hero. -->
                                    <Grid x:Name="PART_CapsuleHero"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Bottom"
                                          Margin="125,0,0,96"
                                          Width="780"
                                          Panel.ZIndex="12">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CapsuleLaunchTransitionActive}" Value="True">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="0"
                                                                                     Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     To="1"
                                                                                     Duration="0:0:0.24">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <StackPanel x:Name="PART_CapsuleHeroContent"
                                                    RenderTransformOrigin="0,0.5">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform X="0" />
                                            </StackPanel.RenderTransform>

                                            <TextBlock Text="{Binding SelectedGame.DisplayName}"
                                                       Foreground="White"
                                                       FontFamily="{DynamicResource FontTitilliumWebBold}"
                                                       FontSize="76"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="780" />

                                            <TextBlock Text="{Binding CapsuleSelectedGameDescription}"
                                                       Margin="3,8,0,0"
                                                       Width="690"
                                                       MaxHeight="82"
                                                       Foreground="#E8FFFFFF"
                                                       FontFamily="{DynamicResource FontTitilliumWeb}"
                                                       FontSize="27"
                                                       LineHeight="34"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{Binding CapsuleSelectedGameGenres}"
                                                       Margin="3,24,0,0"
                                                       Width="700"
                                                       Foreground="#AFFFFFFF"
                                                       FontFamily="{DynamicResource FontTitilliumWeb}"
                                                       FontSize="23"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Orientation="Horizontal" Margin="0,43,0,0">
                                                <Grid Width="555" Height="86">
                                                    <ButtonEx x:Name="PART_ButtonInstall"
                                                              Style="{StaticResource CapsuleHeroPrimaryButton}"
                                                              Content="{DynamicResource LOCInstallGame}" />
                                                    <ButtonEx x:Name="PART_ButtonPlay"
                                                              Style="{StaticResource CapsuleHeroPrimaryButton}"
                                                              Content="{DynamicResource LOCPlayGame}" />
                                                </Grid>

                                                <ButtonEx x:Name="PART_ButtonGameOptions"
                                                          Margin="20,0,0,0"
                                                          Style="{StaticResource CapsuleHeroMoreButton}"
                                                          Content="•••" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hidden legacy hooks retained until their Capsule screens are drawn. -->
                                    <Grid Visibility="Collapsed">
                                        <ButtonEx x:Name="PART_ButtonNotifications" />
                                        <ButtonEx x:Name="PART_ButtonProgramUpdate" />
                                        <ButtonEx x:Name="PART_ButtonSearch" />
                                        <ButtonEx x:Name="PART_ButtonFilter" />
                                        <ButtonEx x:Name="PART_ButtonDetails" />
                                        <TextBlock x:Name="PART_TextBatteryPercentage" />
                                        <ContentControl x:Name="PART_ElemBatteryStatus" />
                                        <TextBlock x:Name="PART_TextProgressTooltip" />
                                        <ContentControl x:Name="PART_ElemProgressIndicator" />
                                        <TextBlock x:Name="PART_ElemExtraFilterActive" />
                                        <StackPanel x:Name="PART_ElemSearchActive" />
                                        <Filters x:Name="PART_ElemFilters" />
                                        <FiltersAdditional x:Name="PART_ElemFiltersAdditional" />
                                        <ContentControl x:Name="PART_ContentFilterItems" />
                                        <FilterPresetSelector x:Name="PART_FilterPresetSelector" />
                                    </Grid>
                                </Grid>
                            </Viewbox>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Panel.ZIndex="100" />

                        <GameStatus x:Name="PART_ElemGameStatus"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Panel.ZIndex="110" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
